# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHAT THO - FI
# Lưu ý: Không lưu secret hoặc mật khẩu thật vào tệp này
# ==========================================

# Cấu hình Server & Cổng mạng
PORT=3000
NODE_ENV=development
RENDER_EXTERNAL_URL=https://chat-tho-fi-vn.onrender.com

# URL Database PostgreSQL (Supabase / Neon Pooling & Direct)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Tự động đồng bộ schema khi boot (true/false)
DB_SYNC=false

# JSON Web Token Secret (Dùng để ký và kiểm thực JWT người dùng)
JWT_SECRET=your_jwt_super_secret_key_here_at_least_32_characters

# Cloudflare R2 Object Storage (Zero Egress Bandwidth)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tho-fi-media
R2_PUBLIC_DOMAIN=https://pub-451f105d0f0c42059b2b37383786f9b9.r2.dev

# Supabase Storage & Client API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Google Firebase FCM (Push Notifications)
# Dùng chuỗi JSON rút gọn của file service account hoặc đường dẫn file firebase-key.json
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# Khởi tạo Super Admin (Dùng cho script seed_admin.js an toàn)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password_here
SUPER_ADMIN_FULLNAME="Super Administrator"
SUPER_ADMIN_EMAIL=admin@chat-tho-fi.internal
